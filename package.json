{
  "name": "interface-systems-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "cross-env PAGES_BASE_PATH=/interface-systems-lab next build",
    "start": "next start",
    "preview:prepare": "node scripts/prepare-preview.mjs",
    "lint": "eslint .",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:export": "node --test tests/export.test.mjs",
    "test:browser": "playwright test",
    "verify:export": "node scripts/verify-export.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm run test:unit && npm run build:pages && npm run test:export"
  },
  "dependencies": {
    "interactive-surface-css": "1.3.0",
    "layout-style-css": "1.1.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ui-style-kit-css": "2.0.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "serve": "14.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Interface Systems Lab"
}
